     1	// Package store is the ClickHouse-backed eventstore.Store implementation for
     2	// the archive relay. It owns the tier tables, the tombstone dictionary,
     3	// per-tier batched inserts, and replaceable dedup via ReplacingMergeTree
     4	// with FINAL on read.
     5	package store
     6	
     7	import (
     8		"context"
     9		"encoding/json"
    10		"errors"
    11		"fmt"
    12		"log/slog"
    13		"sort"
    14		"time"
    15	
    16		"github.com/ClickHouse/clickhouse-go/v2"
    17		"github.com/ClickHouse/clickhouse-go/v2/lib/driver"
    18		"github.com/nbd-wtf/go-nostr"
    19	
    20		"github.com/nostr-net/archive-relay/internal/config"
    21	)
    22	
    23	// Store implements eventstore.Store (Init/Close/QueryEvents/SaveEvent/
    24	// DeleteEvent/ReplaceEvent) plus Counter (CountEvents) over ClickHouse.
    25	type Store struct {
    26		ch    driver.Conn
    27		cfg   *config.Config
    28		log   *slog.Logger
    29		tiers map[string]*batcher // keyed by tier name
    30	}
    31	
    32	// New constructs an unopened Store. Call Init() to connect + create schema.
    33	func New(cfg *config.Config, log *slog.Logger) *Store {
    34		return &Store{cfg: cfg, log: log}
    35	}
    36	
    37	// Init connects to ClickHouse, creates the schema, and starts the batchers.
    38	func (s *Store) Init() error {
    39		opts := &clickhouse.Options{
    40			Addr: []string{s.cfg.ClickHouse.Addr},
    41			Auth: clickhouse.Auth{
    42				Database: s.cfg.ClickHouse.Database,
    43				Username: s.cfg.ClickHouse.Username,
    44				Password: s.cfg.ClickHouse.Password,
    45			},
    46			DialTimeout: 5 * time.Second,
    47			Settings:    clickhouse.Settings{"max_execution_time": 120},
    48		}
    49		conn, err := clickhouse.Open(opts)
    50		if err != nil {
    51			return fmt.Errorf("clickhouse open: %w", err)
    52		}
    53	
    54		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
    55		defer cancel()
    56		if err := conn.Ping(ctx); err != nil {
    57			return fmt.Errorf("clickhouse ping %s: %w", s.cfg.ClickHouse.Addr, err)
    58		}
    59		s.ch = conn
    60	
    61		if err := s.initSchema(ctx); err != nil {
    62			return err
    63		}
    64	
    65		// start one batcher per active tier
    66		s.tiers = make(map[string]*batcher, len(activeTiers))
    67		for _, t := range activeTiers {
    68			b := newBatcher(conn, t, s.cfg.Batch.MaxSize, s.cfg.Batch.MaxAge, s.log.With("tier", t))
    69			b.start()
    70			s.tiers[t] = b
    71		}
    72		s.log.Info("store initialized", "tiers", activeTiers)
    73		return nil
    74	}
    75	
    76	// FlushAll synchronously flushes every tier's batch buffer into ClickHouse.
    77	// Used by tests (and a future graceful-SIGTERM drain).
    78	func (s *Store) FlushAll() {
    79		for _, b := range s.tiers {
    80			b.FlushAll()
    81		}
    82	}
    83	
    84	// CH exposes the underlying ClickHouse connection for subsystems (stats refresh
    85	// jobs, the API) that run their own queries. Read-only callers only.
    86	func (s *Store) CH() driver.Conn { return s.ch }
    87	
    88	// SetOnFlushed registers a callback fired after a batch is durably written to
    89	// ClickHouse on ANY tier. Used by the crawler to record durable dedup state
    90	// only after the data is safe — never mark an event "seen" before it is stored.
    91	// Safe to call at any time (the callback is stored atomically).
    92	func (s *Store) SetOnFlushed(fn func(events []*nostr.Event)) {
    93		for _, b := range s.tiers {
    94			b.onFlushed.Store(&fn)
    95		}
    96	}
    97	
    98	// Close flushes all batchers and closes the connection. Safe to call once.
    99	func (s *Store) Close() {
   100		for _, b := range s.tiers {
   101			b.shutdown()
   102		}
   103		if s.ch != nil {
   104			_ = s.ch.Close()
   105		}
   106	}
   107	
   108	// SaveEvent routes the event to its tier's batcher. Out-of-scope (drop) kinds
   109	// are rejected here as a defense-in-depth; the policy layer normally drops
   110	// them earlier at RejectEvent.
   111	func (s *Store) SaveEvent(ctx context.Context, evt *nostr.Event) error {
   112		tier := tierForEvent(evt, s.cfg.Classifier)
   113		if tier == TierDrop {
   114			return errors.New("event kind out of scope")
   115		}
   116		b, ok := s.tiers[tier]
   117		if !ok {
   118			return fmt.Errorf("no batcher for tier %q", tier)
   119		}
   120		return b.enqueue(evt)
   121	}
   122	
   123	// DeleteEvent records a tombstone (instant hide via the dictionary) and reloads
   124	// the dictionary so the hide is visible to subsequent reads immediately.
   125	// Physical reclamation, if ever wanted, is a separate periodic ALTER DELETE job.
   126	func (s *Store) DeleteEvent(ctx context.Context, evt *nostr.Event) error {
   127		return s.retireIDs(ctx, []string{evt.ID}, "nip09", evt.PubKey)
   128	}
   129	
   130	// retireIDs tombstones a batch of event ids with a single dictionary reload, so
   131	// the hides are visible to subsequent reads immediately. Used by DeleteEvent
   132	// (NIP-09) and ReplaceEvent (superseded versions). reason is a short
   133	// LowCardinality label ("nip09" / "replaced"); deletedBy is the acting pubkey
   134	// ("" when unknown, e.g. internal retirement). An insert error aborts the batch;
   135	// the caller decides whether to surface or log it.
   136	func (s *Store) retireIDs(ctx context.Context, ids []string, reason, deletedBy string) error {
   137		if len(ids) == 0 {
   138			return nil
   139		}
   140		ctx2, cancel := context.WithTimeout(ctx, 5*time.Second)
   141		defer cancel()
   142		for _, id := range ids {
   143			if err := s.ch.Exec(ctx2,
   144				"INSERT INTO tombstones (id, reason, deleted_by) VALUES (?, ?, ?)",
   145				id, reason, deletedBy); err != nil {
   146				return err
   147			}
   148		}
   149		// make the hides visible now (auto-refresh would also do this within LIFETIME)
   150		_ = s.ch.Exec(ctx2, "SYSTEM RELOAD DICTIONARY tombstone_dict")
   151		return nil
   152	}
   153	
   154	// ReplaceEvent implements nostr replaceable/addressable semantics: only the
   155	// latest version per (pubkey, kind) — tie-broken by lowest id (NIP-01) — should
   156	// be served. Because the tier ORDER BY includes created_at (for query
   157	// performance), ReplacingMergeTree alone does NOT collapse different versions,
   158	// so we retire older versions via the tombstone path and save the new one.
   159	// Non-replaceable kinds fall through to a plain save.
   160	func (s *Store) ReplaceEvent(ctx context.Context, evt *nostr.Event) error {
   161		if !isReplaceableKind(evt.Kind) {
   162			return s.SaveEvent(ctx, evt)
   163		}
   164		// fetch current versions for this (pubkey, kind) — already tombstone-filtered
   165		ch, err := s.QueryEvents(ctx, nostr.Filter{
   166			Authors: []string{evt.PubKey}, Kinds: []int{evt.Kind}, Limit: 100,
   167		})
   168		if err != nil {
   169			return fmt.Errorf("replace query: %w", err)
   170		}
   171		shouldStore := true
   172		var retire []string
   173		for prev := range ch {
   174			// prev is "older" (should be retired) if it has an earlier timestamp,
   175			// or the same timestamp but a higher id (NIP-01 keeps the lowest id).
   176			prevOlder := prev.CreatedAt < evt.CreatedAt ||
   177				(prev.CreatedAt == evt.CreatedAt && prev.ID > evt.ID)
   178			if prevOlder {
   179				retire = append(retire, prev.ID)
   180			} else {
   181				shouldStore = false // an equal-or-newer version exists; discard incoming
   182			}
   183		}
   184		// retire all superseded versions in one batch with a single dictionary reload
   185		if len(retire) > 0 {
   186			if err := s.retireIDs(ctx, retire, "replaced", evt.PubKey); err != nil {
   187				s.log.Warn("retire superseded versions failed", "n", len(retire), "err", err)
   188			}
   189		}
   190		if shouldStore {
   191			return s.SaveEvent(ctx, evt)
   192		}
   193		return nil
   194	}
   195	
   196	// QueryEvents streams events matching the filter, querying each relevant tier
   197	// with FINAL (so replaceable/addressable dedup is correct) and merging in Go.
   198	// The tombstone predicate is added by buildFilterSQL.
   199	func (s *Store) QueryEvents(ctx context.Context, f nostr.Filter) (chan *nostr.Event, error) {
   200		where, args, tail := buildFilterSQL(f)
   201		tiers := tiersForFilter(f, s.cfg.Classifier)
   202	
   203		// Merge across tiers in Go: collect, sort by created_at desc, respect Limit.
   204		limit := f.Limit
   205		if limit < 1 || limit > defaultQueryLimit {
   206			limit = defaultQueryLimit
   207		}
   208	
   209		out := make(chan *nostr.Event, 64)
   210		go func() {
   211			defer close(out)
   212			var collected []*nostr.Event
   213			for _, t := range tiers {
   214				if ctx.Err() != nil {
   215					return
   216				}
   217				q := fmt.Sprintf("SELECT %s FROM events_%s FINAL WHERE %s%s",
   218					tierColumns, t, where, tail)
   219				rows, err := s.ch.Query(ctx, q, args...)
   220				if err != nil {
   221					s.log.Error("query failed", "tier", t, "err", err)
   222					continue
   223				}
   224				n := 0
   225				for rows.Next() {
   226					e, err := scanEvent(rows)
   227					if err != nil {
   228						s.log.Error("scan event failed", "tier", t, "err", err)
   229						_ = rows.Close()
   230						return
   231					}
   232					collected = append(collected, e)
   233					n++
   234				}
   235				_ = rows.Close()
   236				s.log.Info("tier scan", "tier", t, "rows", n)
   237			}
   238			// stable-ish ordering across tiers + global limit
   239			sortDesc(collected)
   240			if len(collected) > limit {
   241				collected = collected[:limit]
   242			}
   243			for _, e := range collected {
   244				select {
   245				case out <- e:
   246				case <-ctx.Done():
   247					return
   248				}
   249			}
   250		}()
   251		return out, nil
   252	}
   253	
   254	// CountEvents returns the count of matching live (non-tombstoned) events,
   255	// deduped via FINAL per tier.
   256	func (s *Store) CountEvents(ctx context.Context, f nostr.Filter) (int64, error) {
   257		where, args, _ := buildFilterSQL(f)
   258		tiers := tiersForFilter(f, s.cfg.Classifier)
   259		var total int64
   260		for _, t := range tiers {
   261			q := fmt.Sprintf("SELECT count() FROM events_%s FINAL WHERE %s", t, where)
   262			var n uint64
   263			if err := s.ch.QueryRow(ctx, q, args...).Scan(&n); err != nil {
   264				return 0, err
   265			}
   266			total += int64(n)
   267		}
   268		return total, nil
   269	}
   270	
   271	// tiersForFilter returns the tiers that could contain the filter's kinds.
   272	// Empty Kinds (match-all) → every active tier. Honors the same override map as
   273	// ingest so query routing matches write routing.
   274	func tiersForFilter(f nostr.Filter, override map[int]string) []string {
   275		if len(f.Kinds) == 0 {
   276			return activeTiers
   277		}
   278		seen := map[string]struct{}{}
   279		out := []string{}
   280		for _, k := range f.Kinds {
   281			t := classifyWithOverride(k, override)
   282			if t == TierDrop {
   283				continue
   284			}
   285			if _, ok := seen[t]; ok {
   286				continue
   287			}
   288			seen[t] = struct{}{}
   289			out = append(out, t)
   290		}
   291		return out
   292	}
   293	
   294	func sortDesc(ev []*nostr.Event) {
   295		// stable: equal-timestamp events keep their tier-query order, which already
   296		// sorted by id, so the cross-tier merge is deterministic.
   297		sort.SliceStable(ev, func(i, j int) bool {
   298			return ev[i].CreatedAt > ev[j].CreatedAt
   299		})
   300	}
   301	
   302	// scanEvent reads a tier-table row (in tierColumns order) into a nostr.Event.
   303	func scanEvent(rows driver.Rows) (*nostr.Event, error) {
   304		var (
   305			id, pubkey, content, sig, tagsRaw, tagD, replyTo string
   306			tagE, tagP, tagT                                 []string
   307			createdAt, kind                                  uint32
   308		)
   309		if err := rows.Scan(&id, &pubkey, &createdAt, &kind, &content, &sig, &tagsRaw, &tagE, &tagP, &tagT, &tagD, &replyTo); err != nil {
   310			return nil, err
   311		}
   312		tags := nostr.Tags{}
   313		_ = json.Unmarshal([]byte(tagsRaw), &tags) // tags_raw is authoritative; arrays are accelerators
   314		return &nostr.Event{
   315			ID:        id,
   316			PubKey:    pubkey,
   317			CreatedAt: nostr.Timestamp(createdAt),
   318			Kind:      int(kind),
   319			Content:   content,
   320			Sig:       sig,
   321			Tags:      tags,
   322		}, nil
   323	}

