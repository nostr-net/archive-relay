    94			if rejecting, msg := reject(ctx, filter); rejecting {
    95				ws.WriteJSON(nostr.NoticeEnvelope(msg))
    96				return 0, nil
    97			}
    98		}
    99	
   100		// run the functions to count (generally it will be just one)
   101		var subtotal int64 = 0
   102		var hll *hyperloglog.HyperLogLog
   103		for _, countHLL := range rl.CountEventsHLL {
   104			res, fhll, err := countHLL(ctx, filter, offset)
   105			if err != nil {
   106				ws.WriteJSON(nostr.NoticeEnvelope(err.Error()))
   107			}
   108			subtotal += res
   109			if fhll != nil {
   110				if hll == nil {
   111					hll = fhll
   112				} else {
   113					hll.Merge(fhll)
   114				}
   115			}
   116		}
   117	
   118		return subtotal, hll
   119	}
