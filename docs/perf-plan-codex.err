    52	// NewRelay returns a new relay. It takes a context that, when canceled, will close the relay connection.
    53	func NewRelay(ctx context.Context, url string, opts ...RelayOption) *Relay {
    54		ctx, cancel := context.WithCancelCause(ctx)
    55		r := &Relay{
    56			URL:                           NormalizeURL(url),
    57			connectionContext:             ctx,
    58			connectionContextCancel:       cancel,
    59			Subscriptions:                 xsync.NewMapOf[int64, *Subscription](),
    60			okCallbacks:                   xsync.NewMapOf[string, func(bool, string)](),
    61			writeQueue:                    make(chan writeRequest),
    62			subscriptionChannelCloseQueue: make(chan *Subscription),
    63			requestHeader:                 nil,
    64		}
    65	
    66		for _, opt := range opts {
    67			opt.ApplyRelayOption(r)
    68		}
    69	
    70		return r
    71	}
    72	
    73	// RelayConnect returns a relay object connected to url.
    74	//
    75	// The given subscription is only used during the connection phase. Once successfully connected, cancelling ctx has no effect.
    76	//
    77	// The ongoing relay connection uses a background context. To close the connection, call r.Close().
    78	// If you need fine grained long-term connection contexts, use NewRelay() instead.
    79	func RelayConnect(ctx context.Context, url string, opts ...RelayOption) (*Relay, error) {
    80		r := NewRelay(context.Background(), url, opts...)
    81		err := r.Connect(ctx)
    82		return r, err
    83	}
