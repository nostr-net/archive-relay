go.mod
     1	package store
     2	
     3	import (
     4		"context"
     5		"encoding/json"
     6		"errors"
     7		"log/slog"
     8		"sync"
     9		"sync/atomic"
    10		"time"
    11	
    12		"github.com/ClickHouse/clickhouse-go/v2/lib/driver"
    13		"github.com/nbd-wtf/go-nostr"
    14	)
    15	
    16	// ErrBatchFull is returned by SaveEvent when a tier's buffer is full, so khatru
    17	// rejects the event with OK:false and the client retries / backs off. This is
    18	// the load-shedding backpressure valve.
    19	var ErrBatchFull = errors.New("batch buffer full; event rejected (retry)")
    20	
    21	// batcher decouples SaveEvent from the actual ClickHouse INSERT. It keeps
    22	// a bounded in-memory channel per tier; a single worker goroutine owns the
    23	// buffer and is the ONLY goroutine that touches it. FlushAll requests a flush
    24	// through flushReq and waits for the worker to service it, so there is no race
    25	// between concurrent flushes and appends.
    26	type batcher struct {
    27		conn    driver.Conn
    28		table   string
    29		maxSize int
    30		maxAge  time.Duration
    31		log     *slog.Logger
    32	
    33		// onFlushed, if set, is invoked from the worker after a batch is durably
    34		// written to ClickHouse. Used to record durable dedup state ONLY after the
    35		// data is safe — so a crash never leaves "seen but not stored" holes.
    36		// atomic.Pointer so SetOnFlushed is race-free even after workers start.
    37		onFlushed atomic.Pointer[func([]*nostr.Event)]
    38	
    39		in       chan *nostr.Event
    40		flushReq chan chan error // FlushAll sends a reply chan; worker drains+flushes, then replies
    41	
    42		wg   sync.WaitGroup
    43		stop chan struct{}
    44	}
    45	
    46	func newBatcher(conn driver.Conn, table string, maxSize int, maxAge time.Duration, log *slog.Logger) *batcher {
    47		cap := maxSize * 2
    48		if cap < 1024 {
    49			cap = 1024
    50		}
    51		return &batcher{
    52			conn:     conn,
    53			table:    table,
    54			maxSize:  maxSize,
    55			maxAge:   maxAge,
    56			log:      log,
    57			in:       make(chan *nostr.Event, cap),
    58			flushReq: make(chan chan error, 16),
    59			stop:     make(chan struct{}),
    60		}
    61	}
    62	
    63	func (b *batcher) start() {
    64		b.wg.Add(1)
    65		go b.run()
    66	}
    67	
    68	// enqueue pushes an event toward the worker; returns errBatchFull if the
    69	// channel is saturated (load-shed).
    70	func (b *batcher) enqueue(evt *nostr.Event) error {
    71		select {
    72		case b.in <- evt:
    73			return nil
    74		default:
    75			return ErrBatchFull
    76		}
    77	}
    78	
    79	func (b *batcher) run() {
    80		defer b.wg.Done()
    81		buf := make([]*nostr.Event, 0, b.maxSize)
    82		tick := time.NewTicker(b.maxAge)
    83		defer tick.Stop()
    84	
    85		// drain pulls everything currently in `in` into buf.
    86		drain := func() {
    87			for {
    88				select {
    89				case evt := <-b.in:
    90					buf = append(buf, evt)
    91				default:
    92					return
    93				}
    94			}
    95		}
    96		// flush resets buf and sends the batch; on error, re-appends to buf.
    97		flush := func() {
    98			drain()
    99			if len(buf) == 0 {
   100				return
   101			}
   102			batch := buf
   103			buf = make([]*nostr.Event, 0, b.maxSize)
   104			if err := b.flush(batch); err != nil {
   105				b.log.Error("batch flush failed", "table", b.table, "n", len(batch), "err", err)
   106				// preserve data for the next attempt
   107				buf = append(batch, buf...)
   108				return
   109			}
   110			if fn := b.onFlushed.Load(); fn != nil {
   111				(*fn)(batch)
   112			}
   113		}
   114	
   115		for {
   116			select {
   117			case <-b.stop:
   118				flush()
   119				return
   120			case evt := <-b.in:
   121				buf = append(buf, evt)
   122				if len(buf) >= b.maxSize {
   123					flush()
   124				}
   125			case <-tick.C:
   126				flush()
   127			case reply := <-b.flushReq:
   128				flush()
   129				reply <- nil
   130			}
   131		}
   132	}
   133	
   134	// FlushAll synchronously flushes this tier's buffer (draining the channel
   135	// first). Safe to call concurrently with enqueue.
   136	func (b *batcher) FlushAll() {
   137		reply := make(chan error, 1)
   138		b.flushReq <- reply
   139		select {
   140		case <-reply:
   141		case <-time.After(30 * time.Second):
   142			b.log.Error("FlushAll timed out", "table", b.table)
   143		}
   144	}
   145	
   146	func (b *batcher) shutdown() {
   147		close(b.stop)
   148		b.wg.Wait()
   149	}
   150	
   151	// flush sends a batch via PrepareBatch. ClickHouse creates one part per INSERT,
   152	// so this is the granularity that matters.
   153	func (b *batcher) flush(events []*nostr.Event) error {
   154		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
   155		defer cancel()
   156	
   157		stmt := "INSERT INTO events_" + b.table + " (" + tierColumns + ")"
   158		batch, err := b.conn.PrepareBatch(ctx, stmt)
   159		if err != nil {
   160			return err
   161		}
   162		for _, evt := range events {
   163			if err := batch.Append(rowFromEvent(evt)...); err != nil {
   164				return err
   165			}
   166		}
   167		return batch.Send()
   168	}
   169	
   170	// rowFromEvent extracts a tier-table row (matching tierColumns order) from an event.
   171	func rowFromEvent(evt *nostr.Event) []any {
   172		var tagE, tagP, tagT []string
   173		var tagD string
   174		for _, t := range evt.Tags {
   175			if len(t) < 2 {
   176				continue
   177			}
   178			switch t[0] {
   179			case "e":
   180				tagE = append(tagE, t[1])
   181			case "p":
   182				tagP = append(tagP, t[1])
   183			case "t":
   184				tagT = append(tagT, t[1])
   185			case "d":
   186				tagD = t[1] // first d-tag wins; addressable kinds have one
   187			}
   188		}
   189		tagsJSON, _ := json.Marshal(evt.Tags)
   190		return []any{
   191			evt.ID,
   192			evt.PubKey,
   193			uint32(evt.CreatedAt),
   194			uint32(evt.Kind),
   195			evt.Content,
   196			evt.Sig,
   197			string(tagsJSON),
   198			tagE,
   199			tagP,
   200			tagT,
   201			tagD,
   202			replyTarget(evt.Tags), // NIP-10-resolved direct parent, or "" if not a reply
   203		}
   204	}
   205	
   206	// replyTarget resolves the direct parent of a reply per NIP-10:
   207	//   - if an e-tag has marker "reply", that id is the parent;
   208	//   - else the LAST positional (unmarked) e-tag is the parent (legacy clients);
   209	//   - else the event is not a reply (returns "").
   210	//
   211	// `root`-only and `mention` tags do NOT make this event a reply-to-X. This is
   212	// what fixes the v1 over-count where every e-tagged note was counted as a reply.
   213	func replyTarget(tags nostr.Tags) string {
   214		var lastPositional string
   215		for _, t := range tags {
   216			if len(t) < 2 || t[0] != "e" {
   217				continue
   218			}
   219			marker := ""
   220			if len(t) >= 4 {
   221				marker = t[3]
   222			}
   223			switch marker {
   224			case "reply":
   225				return t[1]
   226			case "", "root":
   227				// positional (empty) or root: track as candidate; root is the thread
   228				// root, acceptable as a fallback parent only if no explicit reply.
   229				if marker == "" {
   230					lastPositional = t[1]
   231				}
   232			}
   233		}
   234		return lastPositional
   235	}
     1	package store
     2	
     3	import (
     4		"encoding/json"
     5		"fmt"
     6		"strings"
     7	
     8		"github.com/nbd-wtf/go-nostr"
     9	)
    10	
    11	// defaultQueryLimit caps the number of rows a REQ returns when the filter's
    12	// Limit is unspecified or absurd. Archives often raise this; 1000 is a safe default.
    13	const defaultQueryLimit = 1000
    14	
    15	// buildFilterSQL turns a nostr.Filter into a WHERE clause + positional args
    16	// (for clickhouse-go's `?` binding) + an ORDER/LIMIT tail. It is a near-1:1
    17	// port of eventstore/postgresql/query.go, adapted to ClickHouse types:
    18	//   - tag predicates use hasAny(Array, Array) on the denormalized tag_* columns
    19	//   - the tombstone predicate `NOT dictHas('tombstone_dict', id)` is always added
    20	//   - replaceable/addressable dedup is handled by the caller via FINAL, not here
    21	//
    22	// The hot single-letter tags e/p/t/d are first-class; arbitrary tag keys (r, a,
    23	// custom) fall back to a tags_raw substring scan (slower, but rare).
    24	func buildFilterSQL(f nostr.Filter) (where string, args []any, tail string) {
    25		var conds []string
    26	
    27		if len(f.IDs) > 0 {
    28			conds = append(conds, "id IN (?)")
    29			args = append(args, f.IDs) // clickhouse-go binds a slice to IN (?)
    30		}
    31		if len(f.Authors) > 0 {
    32			conds = append(conds, "pubkey IN (?)")
    33			args = append(args, f.Authors)
    34		}
    35		if len(f.Kinds) > 0 {
    36			conds = append(conds, "kind IN (?)")
    37			kinds := make([]int32, len(f.Kinds))
    38			for i, k := range f.Kinds {
    39				kinds[i] = int32(k)
    40			}
    41			args = append(args, kinds)
    42		}
    43		for key, vals := range f.Tags {
    44			if len(vals) == 0 {
    45				continue
    46			}
    47			switch key {
    48			case "e":
    49				conds = append(conds, "hasAny(tag_e, ?)")
    50				args = append(args, vals)
    51			case "p":
    52				conds = append(conds, "hasAny(tag_p, ?)")
    53				args = append(args, vals)
    54			case "t":
    55				conds = append(conds, "hasAny(tag_t, ?)")
    56				args = append(args, vals)
    57			case "d":
    58				// d-tag is single-valued; match the first requested value
    59				conds = append(conds, "tag_d = ?")
    60				args = append(args, vals[0])
    61			default:
    62				// arbitrary key: best-effort substring scan over tags_raw JSON.
    63				// e.g. key="r", val="wss://x" -> position(tags_raw, '"r","wss://x"') > 0
    64				// marshal via encoding/json so the escaping matches tags_raw exactly.
    65				kb, _ := json.Marshal(key)
    66				for _, v := range vals {
    67					vb, _ := json.Marshal(v)
    68					conds = append(conds, "position(tags_raw, ?) > 0")
    69					args = append(args, string(kb)+","+string(vb))
    70				}
    71			}
    72		}
    73		if f.Since != nil {
    74			conds = append(conds, "created_at >= ?")
    75			args = append(args, uint32(*f.Since))
    76		}
    77		if f.Until != nil {
    78			conds = append(conds, "created_at <= ?")
    79			args = append(args, uint32(*f.Until))
    80		}
    81	
    82		// Always exclude tombstoned events (NIP-09 / moderation). dictHas is O(1).
    83		conds = append(conds, "NOT dictHas('tombstone_dict', id)")
    84	
    85		if len(conds) == 0 {
    86			where = "1=1"
    87		} else {
    88			where = strings.Join(conds, " AND ")
    89		}
    90	
    91		limit := f.Limit
    92		if limit < 1 || limit > defaultQueryLimit {
    93			limit = defaultQueryLimit
    94		}
    95		tail = fmt.Sprintf(" ORDER BY created_at DESC, id LIMIT %d", limit)
    96		return where, args, tail
    97	}
     1	package store
     2	
     3	import (
     4		"context"
     5		"fmt"
     6		"strings"
     7	)
     8	
     9	// tierColumns is the canonical column list for every tier table, in INSERT order.
    10	// (received_at has a DEFAULT; version is MATERIALIZED — neither is inserted.)
    11	const tierColumns = `id, pubkey, created_at, kind, content, sig, tags_raw, tag_e, tag_p, tag_t, tag_d, reply_to`
    12	
    13	const tierColumnsType = `
    14	  id           String,
    15	  pubkey       String,
    16	  created_at   UInt32,
    17	  kind         UInt32,
    18	  content      String,
    19	  sig          String,
    20	  tags_raw     String,
    21	  tag_e        Array(String),
    22	  tag_p        Array(String),
    23	  tag_t        Array(String),
    24	  tag_d        String,
    25	  reply_to     String,
    26	  received_at  DateTime64(3) DEFAULT now64(3),
    27	  version      UInt32 MATERIALIZED created_at,
    28	  INDEX idx_id      id      TYPE bloom_filter(0.01) GRANULARITY 4,
    29	  INDEX idx_tag_e   tag_e   TYPE bloom_filter(0.01) GRANULARITY 4,
    30	  INDEX idx_tag_p   tag_p   TYPE bloom_filter(0.01) GRANULARITY 4,
    31	  INDEX idx_tag_t   tag_t   TYPE bloom_filter(0.01) GRANULARITY 4,
    32	  INDEX idx_content content TYPE ngrambf_v1(3, 256, 2, 0) GRANULARITY 4
    33	`
    34	
    35	// tierDDL builds a CREATE TABLE statement for one tier. ttlDelete of "" means
    36	// keep forever. The interval is expressed as e.g. "10 YEAR" / "1 YEAR" / "30 DAY"
    37	// and is added to toDateTime(created_at) (created_at is UInt32, so a raw
    38	// created_at + INTERVAL would type-error). The NVMe→S3 cold-tier move
    39	// (TTL ... TO VOLUME 'cold') is an ops-layer concern configured in
    40	// clickhouse-config.xml; it is intentionally NOT emitted here so the DDL works
    41	// against any default single-node install.
    42	func tierDDL(name, ttlDelete string) string {
    43		ttl := ""
    44		if ttlDelete != "" {
    45			ttl = "\n  TTL toDateTime(created_at) + INTERVAL " + ttlDelete + " DELETE"
    46		}
    47		return fmt.Sprintf(`
    48	CREATE TABLE IF NOT EXISTS events_%[1]s (%[2]s
    49	) ENGINE = ReplacingMergeTree(version)
    50	  PARTITION BY toYYYYMM(toDateTime(created_at))
    51	  ORDER BY (kind, pubkey, created_at, id)%[3]s
    52	  SETTINGS index_granularity = 8192;
    53	`, name, tierColumnsType, ttl)
    54	}
    55	
    56	// eventsViewDDL builds the UNION ALL view over all tiers (used by stats and
    57	// ad-hoc queries; the relay read path queries tiers directly with FINAL).
    58	func eventsViewDDL() string {
    59		return `
    60	CREATE OR REPLACE VIEW events_all AS
    61	  SELECT * FROM events_permanent
    62	  UNION ALL SELECT * FROM events_archive
    63	  UNION ALL SELECT * FROM events_social;
    64	`
    65	}
    66	
    67	const tombstonesDDL = `
    68	CREATE TABLE IF NOT EXISTS tombstones (
    69	  id         String,
    70	  reason     LowCardinality(String),
    71	  deleted_by String,
    72	  deleted_at DateTime64(3) DEFAULT now64(3)
    73	) ENGINE = MergeTree ORDER BY (id, deleted_at);
    74	
    75	CREATE DICTIONARY IF NOT EXISTS tombstone_dict (
    76	  id String DEFAULT ''
    77	)
    78	PRIMARY KEY id
    79	SOURCE(CLICKHOUSE(TABLE 'tombstones'))
    80	LAYOUT(HASHED())
    81	LIFETIME(MIN 0 MAX 60);
    82	`
    83	
    84	// snapshotsDDL creates the stats tables. Refresh jobs populate them; they survive
    85	// raw-data TTL.
    86	const snapshotsDDL = `
    87	CREATE TABLE IF NOT EXISTS stats_note_monthly (
    88	  note_id String,
    89	  month   Date,
    90	  metric  LowCardinality(String),
    91	  count   UInt64,
    92	  sats    UInt64
    93	) ENGINE = SummingMergeTree
    94	  PARTITION BY toYYYYMM(month)
    95	  ORDER BY (note_id, month, metric);
    96	
    97	CREATE TABLE IF NOT EXISTS stats_daily (
    98	  day    Date,
    99	  metric LowCardinality(String),
   100	  value  UInt64
   101	) ENGINE = SummingMergeTree
   102	  PARTITION BY toYYYYMM(day)
   103	  ORDER BY (day, metric);
   104	
   105	CREATE TABLE IF NOT EXISTS stats_daily_active (
   106	  day     Date,
   107	  authors AggregateFunction(uniq, String)
   108	) ENGINE = AggregatingMergeTree ORDER BY day;
   109	
   110	CREATE TABLE IF NOT EXISTS author_follower_counts (
   111	  pubkey    String,
   112	  followers UInt64
   113	) ENGINE = MergeTree ORDER BY pubkey;
   114	`
   115	
   116	// initSchema runs all DDL idempotently.
   117	func (s *Store) initSchema(ctx context.Context) error {
   118		ttl := map[string]string{
   119			TierPermanent: s.cfg.Retention.Permanent,
   120			TierArchive:   s.cfg.Retention.Archive,
   121			TierSocial:    s.cfg.Retention.Social,
   122		}
   123		stmts := []string{}
   124		for _, t := range activeTiers {
   125			stmts = append(stmts, tierDDL(t, ttl[t]))
   126		}
   127		stmts = append(stmts, eventsViewDDL(), tombstonesDDL, snapshotsDDL)
   128		for _, q := range stmts {
   129			// split on ';' — clickhouse-go executes one statement per Exec
   130			for _, part := range strings.Split(q, ";") {
   131				part = strings.TrimSpace(part)
   132				if part == "" {
   133					continue
   134				}
   135				if err := s.ch.Exec(ctx, part); err != nil {
   136					return fmt.Errorf("schema init failed on %q: %w", truncate(part, 80), err)
   137				}
   138			}
   139		}
   140		return nil
   141	}
   142	
   143	func truncate(s string, n int) string {
   144		if len(s) <= n {
   145			return s
   146		}
   147		return s[:n] + "…"
   148	}
     1	package store
     2	
     3	import "github.com/nbd-wtf/go-nostr"
     4	
     5	// Tier names. These are both ClickHouse table suffixes and config keys.
     6	const (
     7		TierPermanent = "permanent"
     8		TierArchive   = "archive"
     9		TierSocial    = "social"
    10		TierDrop      = "drop" // never stored
    11	)
    12	
    13	// activeTiers is the set of tiers that receive events (have batchers).
    14	var activeTiers = []string{TierPermanent, TierArchive, TierSocial}
    15	
    16	// TierForKind is the exported scope check used by the policy layer and others.
    17	// Returns the tier name (permanent|archive|social|drop).
    18	func TierForKind(kind int) string { return classify(kind) }
    19	
    20	// InScopeKinds is the list of kinds this relay stores, used by the crawler to
    21	// build its subscription filter. Mirrors the classify() switch.
    22	func InScopeKinds() []int { return []int{0, 1, 3, 6, 7, 16, 9735, 10002} }
    23	
    24	// classify maps a nostr kind to a retention tier, aligned to the social-core
    25	// scope. Unknown kinds → drop.
    26	//
    27	// This is the single source of truth for "what does this relay store". Override
    28	// per-instance via config.Classifier if you want to tune without recompiling.
    29	func classify(kind int) string {
    30		switch kind {
    31		case 0, 3, 9735, 10002: // metadata, contacts, zap receipt, relay list
    32			return TierPermanent
    33		case 1: // text notes
    34			return TierArchive
    35		case 6, 7, 16: // reposts + reactions (stored raw; stats via on-demand/snapshots)
    36			return TierSocial
    37		default:
    38			return TierDrop // ephemeral, DMs, gift wraps, and all out-of-scope NIPs
    39		}
    40	}
    41	
    42	// classifyWithOverride applies an optional config override map on top of the default.
    43	func classifyWithOverride(kind int, override map[int]string) string {
    44		if t, ok := override[kind]; ok {
    45			return t
    46		}
    47		return classify(kind)
    48	}
    49	
    50	// tierForEvent returns the destination tier for an event, honoring config overrides.
    51	func tierForEvent(evt *nostr.Event, override map[int]string) string {
    52		return classifyWithOverride(evt.Kind, override)
    53	}
    54	
    55	// isReplaceableKind reports whether a kind has replaceable/addressable semantics
    56	// (only the latest version per pubkey[/d-tag] is meaningful).
    57	func isReplaceableKind(kind int) bool {
    58		switch kind {
    59		case 0, 3, 10002:
    60			return true
    61		}
    62		return false
    63	}

