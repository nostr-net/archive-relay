    11	
    12	func (rl *Relay) handleDeleteRequest(ctx context.Context, evt *nostr.Event) error {
    13		// event deletion -- nip09
    14		for _, tag := range evt.Tags {
    15			if len(tag) >= 2 {
    16				var f nostr.Filter
    17	
    18				switch tag[0] {
    19				case "e":
    20					f = nostr.Filter{IDs: []string{tag[1]}}
    21				case "a":
    22					spl := strings.SplitN(tag[1], ":", 3)
    23					if len(spl) != 3 {
    24						continue
    25					}
    26					kind, err := strconv.Atoi(spl[0])
    27					if err != nil {
    28						continue
    29					}
    30					author := spl[1]
    31					identifier := spl[2]
    32					f = nostr.Filter{
    33						Kinds:   []int{kind},
    34						Authors: []string{author},
    35						Tags:    nostr.TagMap{"d": []string{identifier}},
    36						Until:   &evt.CreatedAt,
    37					}
    38				default:
    39					continue
    40				}
    41	
    42				ctx := context.WithValue(ctx, internalCallKey, struct{}{})
    43				for _, query := range rl.QueryEvents {
    44					ch, err := query(ctx, f)
    45					if err != nil {
    46						continue
    47					}
    48					target := <-ch
    49					if target == nil {
    50						continue
    51					}
    52					// got the event, now check if the user can delete it
    53					acceptDeletion := target.PubKey == evt.PubKey
    54					var msg string
    55					if !acceptDeletion {
    56						msg = "you are not the author of this event"
    57					}
    58					// but if we have a function to overwrite this outcome, use that instead
    59					for _, odo := range rl.OverwriteDeletionOutcome {
    60						acceptDeletion, msg = odo(ctx, target, evt)
    61					}
    62	
    63					if acceptDeletion {
    64						// delete it
    65						for _, del := range rl.DeleteEvent {
    66							if err := del(ctx, target); err != nil {
    67								return err
    68							}
    69						}
    70	
    71						// if it was tracked to be expired that is not needed anymore
    72						rl.expirationManager.removeEvent(target.ID)
    73					} else {
    74						// fail and stop here
    75						return fmt.Errorf("blocked: %s", msg)
    76					}
    77	
    78					// don't try to query this same event again
    79					break
    80				}
    81			}
    82		}
    83	
    84		return nil
    85	}

