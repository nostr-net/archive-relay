     1	// Package stats maintains the snapshot/aggregate tables and exposes query
     2	// helpers for the stats API. Refresh jobs recompute from FINAL reads with
     3	// count(DISTINCT id), so duplicate ingests never inflate them.
     4	package stats
     5	
     6	import (
     7		"context"
     8		"database/sql"
     9		"errors"
    10		"fmt"
    11		"log/slog"
    12		"time"
    13	
    14		"github.com/ClickHouse/clickhouse-go/v2/lib/driver"
    15	)
    16	
    17	// Service runs the periodic refresh jobs and answers stats queries.
    18	type Service struct {
    19		ch  driver.Conn
    20		log *slog.Logger
    21	}
    22	
    23	// New constructs a stats Service over the given ClickHouse connection.
    24	func New(ch driver.Conn, log *slog.Logger) *Service {
    25		return &Service{ch: ch, log: log}
    26	}
    27	
    28	// Run starts the periodic refresh jobs and blocks until ctx is canceled.
    29	// - followers: every 5 min (read on every profile render, so keep fresh)
    30	// - monthly/daily rollups: hourly (reprocess current+previous bucket)
    31	func (s *Service) Run(ctx context.Context) {
    32		// initial refresh so stats exist immediately after start
    33		s.refreshAll(ctx)
    34	
    35		followerTick := time.NewTicker(5 * time.Minute)
    36		hourly := time.NewTicker(time.Hour)
    37		defer followerTick.Stop()
    38		defer hourly.Stop()
    39		for {
    40			select {
    41			case <-ctx.Done():
    42				return
    43			case <-followerTick.C:
    44				if err := s.RefreshFollowers(ctx); err != nil {
    45					s.log.Warn("follower refresh failed", "err", err)
    46				}
    47			case <-hourly.C:
    48				s.refreshAll(ctx)
    49			}
    50		}
    51	}
    52	
    53	func (s *Service) refreshAll(ctx context.Context) {
    54		if err := s.RefreshFollowers(ctx); err != nil {
    55			s.log.Warn("follower refresh failed", "err", err)
    56		}
    57		if err := s.RefreshNoteMonthly(ctx); err != nil {
    58			s.log.Warn("note-monthly refresh failed", "err", err)
    59		}
    60		if err := s.RefreshDaily(ctx); err != nil {
    61			s.log.Warn("daily refresh failed", "err", err)
    62		}
    63		if err := s.RefreshDailyActive(ctx); err != nil {
    64			s.log.Warn("daily-active refresh failed", "err", err)
    65		}
    66	}
    67	
    68	// RefreshFollowers recomputes per-author follower counts from the latest kind-3
    69	// contact list of each author: TRUNCATE then repopulate (cheap relative to the
    70	// scan), so the table engine can be a plain MergeTree.
    71	func (s *Service) RefreshFollowers(ctx context.Context) error {
    72		if err := s.ch.Exec(ctx, "TRUNCATE TABLE author_follower_counts"); err != nil {
    73			return fmt.Errorf("truncate: %w", err)
    74		}
    75		q := `
    76	INSERT INTO author_follower_counts (pubkey, followers)
    77	SELECT p_tag AS pubkey, count(DISTINCT author) AS followers
    78	FROM (
    79	  SELECT pubkey AS author, arrayJoin(tag_p) AS p_tag
    80	  FROM (SELECT * FROM events_permanent FINAL WHERE kind = 3 ORDER BY created_at DESC LIMIT 1 BY pubkey)
    81	)
    82	GROUP BY p_tag`
    83		return s.ch.Exec(ctx, q)
    84	}
    85	
    86	// RefreshNoteMonthly recomputes per-note-per-month engagement for the current
    87	// and previous month (stragglers); older months are frozen.
    88	func (s *Service) RefreshNoteMonthly(ctx context.Context) error {
    89		if err := s.ch.Exec(ctx,
    90			"DELETE FROM stats_note_monthly WHERE month >= toStartOfMonth(addMonths(today(), -1))"); err != nil {
    91			return fmt.Errorf("delete: %w", err)
    92		}
    93		q := `
    94	INSERT INTO stats_note_monthly (note_id, month, metric, count, sats)
    95	SELECT note_id, month, metric,
    96	       count(DISTINCT id) AS count,
    97	       sum(if(metric = 'zap', toUInt64OrZero(extract(tags_raw, '"amount","([0-9]+)"')), 0)) AS sats
    98	FROM (
    99	  SELECT
   100	    multiIf(kind = 1, reply_to, tag_e[1]) AS note_id,
   101	    toStartOfMonth(toDateTime(created_at)) AS month,
   102	    multiIf(kind = 7, 'reaction', kind IN (6, 16), 'repost', kind = 1, 'reply', kind = 9735, 'zap', '') AS metric,
   103	    id, tags_raw
   104	  FROM events_all
   105	  WHERE kind IN (1, 6, 7, 16, 9735)
   106	    AND ((kind = 1 AND reply_to != '') OR (kind IN (6, 7, 16, 9735) AND length(tag_e) >= 1))
   107	    AND created_at >= toUnixTimestamp(toStartOfMonth(addMonths(today(), -1)))
   108	)
   109	WHERE metric != '' AND note_id != ''
   110	GROUP BY note_id, month, metric`
   111		return s.ch.Exec(ctx, q)
   112	}
   113	
   114	// RefreshDaily recomputes the daily network rollups for the last 3 days.
   115	func (s *Service) RefreshDaily(ctx context.Context) error {
   116		if err := s.ch.Exec(ctx, "DELETE FROM stats_daily WHERE day >= today() - 3"); err != nil {
   117			return fmt.Errorf("delete: %w", err)
   118		}
   119		q := `
   120	INSERT INTO stats_daily (day, metric, value)
   121	SELECT day, metric, count(DISTINCT id) AS value
   122	FROM (
   123	  SELECT toDate(toDateTime(created_at)) AS day,
   124	         multiIf(kind = 1, 'posts', kind = 7, 'reactions', kind IN (6, 16), 'reposts', kind = 9735, 'zaps', '') AS metric,
   125	         id
   126	  FROM events_all
   127	  WHERE kind IN (1, 6, 7, 16, 9735) AND created_at >= toUnixTimestamp(today() - 3)
   128	)
   129	WHERE metric != ''
   130	GROUP BY day, metric`
   131		return s.ch.Exec(ctx, q)
   132	}
   133	
   134	// RefreshDailyActive recomputes DAU (distinct active authors) for last 3 days.
   135	func (s *Service) RefreshDailyActive(ctx context.Context) error {
   136		if err := s.ch.Exec(ctx, "DELETE FROM stats_daily_active WHERE day >= today() - 3"); err != nil {
   137			return fmt.Errorf("delete: %w", err)
   138		}
   139		q := `
   140	INSERT INTO stats_daily_active (day, authors)
   141	SELECT toDate(toDateTime(created_at)) AS day, uniqState(pubkey) AS authors
   142	FROM events_all
   143	WHERE created_at >= toUnixTimestamp(today() - 3)
   144	GROUP BY day`
   145		return s.ch.Exec(ctx, q)
   146	}
   147	
   148	// --- query helpers (used by the HTTP API) ---
   149	
   150	// Engagement returns the all-time per-metric engagement for a note.
   151	func (s *Service) Engagement(ctx context.Context, noteID string) (map[string]int64, error) {
   152		rows, err := s.ch.Query(ctx,
   153			`SELECT metric, sum(count), sum(sats) FROM stats_note_monthly WHERE note_id = ? GROUP BY metric`,
   154			noteID)
   155		if err != nil {
   156			return nil, err
   157		}
   158		defer rows.Close()
   159		out := map[string]int64{}
   160		for rows.Next() {
   161			var metric string
   162			var c, ss uint64
   163			if err := rows.Scan(&metric, &c, &ss); err != nil {
   164				return nil, err
   165			}
   166			out[metric] = int64(c)
   167			out[metric+"_sats"] = int64(ss)
   168		}
   169		return out, nil
   170	}
   171	
   172	// Daily returns per-day metric totals for the last `days` days.
   173	func (s *Service) Daily(ctx context.Context, days int) ([]DailyRow, error) {
   174		rows, err := s.ch.Query(ctx,
   175			`SELECT day, metric, sum(value) FROM stats_daily
   176			 WHERE day >= today() - ? GROUP BY day, metric ORDER BY day DESC, metric`,
   177			int32(days))
   178		if err != nil {
   179			return nil, err
   180		}
   181		defer rows.Close()
   182		var out []DailyRow
   183		for rows.Next() {
   184			var r DailyRow
   185			if err := rows.Scan(&r.Day, &r.Metric, &r.Value); err != nil {
   186				return nil, err
   187			}
   188			out = append(out, r)
   189		}
   190		return out, nil
   191	}
   192	
   193	// DAU returns daily active authors for the last `days` days.
   194	func (s *Service) DAU(ctx context.Context, days int) ([]DAURow, error) {
   195		rows, err := s.ch.Query(ctx,
   196			`SELECT day, uniqMerge(authors) FROM stats_daily_active
   197			 WHERE day >= today() - ? GROUP BY day ORDER BY day DESC`,
   198			int32(days))
   199		if err != nil {
   200			return nil, err
   201		}
   202		defer rows.Close()
   203		var out []DAURow
   204		for rows.Next() {
   205			var r DAURow
   206			if err := rows.Scan(&r.Day, &r.Active); err != nil {
   207				return nil, err
   208			}
   209			out = append(out, r)
   210		}
   211		return out, nil
   212	}
   213	
   214	// Followers returns the follower count for a pubkey (0 if unknown/not yet
   215	// snapshotted). A missing row is a known "0", not an error.
   216	func (s *Service) Followers(ctx context.Context, pubkey string) (int64, error) {
   217		var n uint64
   218		err := s.ch.QueryRow(ctx,
   219			`SELECT followers FROM author_follower_counts WHERE pubkey = ?`, pubkey).Scan(&n)
   220		if err != nil {
   221			if errors.Is(err, sql.ErrNoRows) {
   222				return 0, nil
   223			}
   224			return 0, err
   225		}
   226		return int64(n), nil
   227	}
   228	
   229	type DailyRow struct {
   230		Day    time.Time
   231		Metric string
   232		Value  uint64
   233	}
   234	
   235	type DAURow struct {
   236		Day    time.Time
   237		Active uint64
   238	}
     1	// Package api exposes REST endpoints over the stats snapshot tables and the
     2	// live store: engagement, daily rollups, DAU, follower counts, and basic event
     3	// queries. Mounted on the khatru relay's HTTP mux.
     4	package api
     5	
     6	import (
     7		"context"
     8		"encoding/json"
     9		"log/slog"
    10		"net/http"
    11		"strconv"
    12		"time"
    13	
    14		"github.com/nbd-wtf/go-nostr"
    15	
    16		"github.com/nostr-net/archive-relay/internal/policy"
    17		"github.com/nostr-net/archive-relay/internal/stats"
    18		"github.com/nostr-net/archive-relay/internal/store"
    19	)
    20	
    21	// Handler holds dependencies for the HTTP handlers.
    22	type Handler struct {
    23		stats   *stats.Service
    24		store   *store.Store
    25		limiter *policy.Limiter // optional per-IP REST rate limit
    26		access  *policy.Access  // optional: when enabled, /v1/* requires NIP-98 + allow-list
    27		log     *slog.Logger
    28	}
    29	
    30	// NewHandler constructs the API handler. limiter and access may be nil.
    31	func NewHandler(s *stats.Service, st *store.Store, limiter *policy.Limiter,
    32		access *policy.Access, log *slog.Logger) *Handler {
    33		return &Handler{stats: s, store: st, limiter: limiter, access: access, log: log}
    34	}
    35	
    36	// Register mounts the API routes on the given mux.
    37	func (h *Handler) Register(mux *http.ServeMux) {
    38		register := func(pattern string, fn http.HandlerFunc, public bool) {
    39			var handler http.Handler = http.HandlerFunc(fn)
    40			// auth first in the chain = innermost wrap: rate-limit cheaply, then
    41			// pay the NIP-98 signature check only for requests under the limit.
    42			if !public && h.access != nil {
    43				handler = h.access.HTTPAuth(handler)
    44			}
    45			if h.limiter != nil {
    46				handler = h.limiter.HTTP(handler)
    47			}
    48			mux.Handle(pattern, handler)
    49		}
    50		register("/v1/health", h.health, true) // liveness probe stays open
    51		register("/v1/stats/daily", h.daily, false)
    52		register("/v1/stats/dau", h.dau, false)
    53		register("/v1/note/", h.noteEngagement, false)
    54		register("/v1/pubkey/", h.followers, false)
    55		register("/v1/events", h.events, false)
    56	}
    57	
    58	func (h *Handler) health(w http.ResponseWriter, r *http.Request) {
    59		ctx, cancel := context.WithTimeout(r.Context(), 2*time.Second)
    60		defer cancel()
    61		chOK := h.store.CH().Ping(ctx) == nil
    62		var events uint64
    63		if chOK {
    64			_ = h.store.CH().QueryRow(ctx, "SELECT count() FROM events_all").Scan(&events)
    65		}
    66		code := http.StatusOK
    67		if !chOK {
    68			code = http.StatusServiceUnavailable
    69		}
    70		writeJSON(w, code, map[string]any{"ok": chOK, "clickhouse": chOK, "events": events})
    71	}
    72	
    73	func (h *Handler) daily(w http.ResponseWriter, r *http.Request) {
    74		days := queryInt(r, "days", 30)
    75		rows, err := h.stats.Daily(r.Context(), days)
    76		if err != nil {
    77			writeErr(w, err)
    78			return
    79		}
    80		writeJSON(w, http.StatusOK, rows)
    81	}
    82	
    83	func (h *Handler) dau(w http.ResponseWriter, r *http.Request) {
    84		days := queryInt(r, "days", 30)
    85		rows, err := h.stats.DAU(r.Context(), days)
    86		if err != nil {
    87			writeErr(w, err)
    88			return
    89		}
    90		writeJSON(w, http.StatusOK, rows)
    91	}
    92	
    93	func (h *Handler) noteEngagement(w http.ResponseWriter, r *http.Request) {
    94		id := r.URL.Path[len("/v1/note/"):]
    95		if id == "" {
    96			http.Error(w, "missing note id", http.StatusBadRequest)
    97			return
    98		}
    99		eng, err := h.stats.Engagement(r.Context(), id)
   100		if err != nil {
   101			writeErr(w, err)
   102			return
   103		}
   104		writeJSON(w, http.StatusOK, eng)
   105	}
   106	
   107	func (h *Handler) followers(w http.ResponseWriter, r *http.Request) {
   108		pk := r.URL.Path[len("/v1/pubkey/"):]
   109		if pk == "" {
   110			http.Error(w, "missing pubkey", http.StatusBadRequest)
   111			return
   112		}
   113		n, err := h.stats.Followers(r.Context(), pk)
   114		if err != nil {
   115			writeErr(w, err)
   116			return
   117		}
   118		writeJSON(w, http.StatusOK, map[string]any{"pubkey": pk, "followers": n})
   119	}
   120	
   121	// events is a minimal event query endpoint (clients usually use the ws relay,
   122	// but a REST mirror is handy).
   123	func (h *Handler) events(w http.ResponseWriter, r *http.Request) {
   124		q := r.URL.Query()
   125		f := nostr.Filter{
   126			Kinds:   parseInts(q["kind"]),
   127			Authors: q["author"],
   128			IDs:     q["id"],
   129			Limit:   queryInt(r, "limit", 100),
   130		}
   131		ch, err := h.store.QueryEvents(r.Context(), f)
   132		if err != nil {
   133			writeErr(w, err)
   134			return
   135		}
   136		var out []*nostr.Event
   137		for ev := range ch {
   138			out = append(out, ev)
   139		}
   140		writeJSON(w, http.StatusOK, out)
   141	}
   142	
   143	// --- helpers ---
   144	
   145	func writeJSON(w http.ResponseWriter, code int, v any) {
   146		w.Header().Set("Content-Type", "application/json")
   147		w.WriteHeader(code)
   148		_ = json.NewEncoder(w).Encode(v)
   149	}
   150	
   151	func writeErr(w http.ResponseWriter, err error) {
   152		http.Error(w, err.Error(), http.StatusInternalServerError)
   153	}
   154	
   155	func queryInt(r *http.Request, key string, def int) int {
   156		s := r.URL.Query().Get(key)
   157		if s == "" {
   158			return def
   159		}
   160		n, err := strconv.Atoi(s)
   161		if err != nil || n < 1 {
   162			return def
   163		}
   164		return n
   165	}
   166	
   167	func parseInts(ss []string) []int {
   168		var out []int
   169		for _, s := range ss {
   170			if n, err := strconv.Atoi(s); err == nil {
   171				out = append(out, n)
   172			}
   173		}
   174		return out
   175	}
     1	// Command archive-relay runs the Nostr archive relay: a khatru relay backed by
     2	// ClickHouse (events/stats) and embedded SQLite (control plane), with a live
     3	// crawler ingesting from upstream relays and a stats refresh service.
     4	package main
     5	
     6	import (
     7		"context"
     8		"flag"
     9		"log/slog"
    10		"net/http"
    11		_ "net/http/pprof" // registers /debug/pprof handlers on http.DefaultServeMux
    12		"os"
    13		"os/signal"
    14		"strings"
    15		"syscall"
    16		"time"
    17	
    18		"github.com/fiatjaf/khatru"
    19		"github.com/nbd-wtf/go-nostr"
    20	
    21		"github.com/nostr-net/archive-relay/internal/api"
    22		"github.com/nostr-net/archive-relay/internal/config"
    23		"github.com/nostr-net/archive-relay/internal/control"
    24		"github.com/nostr-net/archive-relay/internal/crawler"
    25		"github.com/nostr-net/archive-relay/internal/policy"
    26		"github.com/nostr-net/archive-relay/internal/relay"
    27		"github.com/nostr-net/archive-relay/internal/scheduler"
    28		"github.com/nostr-net/archive-relay/internal/stats"
    29		"github.com/nostr-net/archive-relay/internal/store"
    30	)
    31	
    32	func main() {
    33		configPath := flag.String("config", "", "path to config.yaml (optional)")
    34		sources := flag.String("sources",
    35			"wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.nostr.net",
    36			"comma-separated upstream relay URLs to crawl")
    37		flag.Parse()
    38	
    39		log := slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo}))
    40	
    41		cfg, err := config.Load(*configPath)
    42		if err != nil {
    43			log.Error("config load failed", "err", err)
    44			os.Exit(1)
    45		}
    46	
    47		// Control plane (embedded SQLite) — crawler/scheduler/auth state.
    48		cdb, err := control.Open(cfg.SQLite.Path, log.With("pkg", "control"))
    49		if err != nil {
    50			log.Error("control db init failed", "err", err)
    51			os.Exit(1)
    52		}
    53		defer cdb.Close()
    54	
    55		// Event store (ClickHouse) — all events, tombstones, snapshots.
    56		s := store.New(cfg, log.With("pkg", "store"))
    57		if err := s.Init(); err != nil {
    58			log.Error("store init failed", "err", err)
    59			os.Exit(1)
    60		}
    61		defer s.Close()
    62	
    63		ctx, cancel := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
    64		defer cancel()
    65	
    66		// Shared dedup layer for every ingestion path (firehose + priority crawl).
    67		// Durable dedup state (seen_events) is recorded only after a batch is flushed
    68		// to ClickHouse, so a crash never marks an event "seen" before it's stored;
    69		// Warm preloads the recent ids so a restart doesn't re-ingest the firehose.
    70		dedup := crawler.NewDedup(cdb, log.With("pkg", "dedup"))
    71		if err := dedup.Warm(ctx); err != nil {
    72			log.Warn("dedup warm failed (starting cold)", "err", err)
    73		}
    74		s.SetOnFlushed(dedup.OnFlushed)
    75	
    76		// Firehose crawler: subscribe to in-scope kinds from the -sources relays.
    77		cr := crawler.New(splitSources(*sources), s, dedup, log.With("pkg", "crawler"))
    78		go cr.Run(ctx)
    79	
    80		// Priority crawler (separate relay list): actively fetch the full in-scope
    81		// history of a configured pubkey set so their events are never missed.
    82		if len(cfg.Crawler.PriorityPubkeys) > 0 || len(cfg.Crawler.Relays) > 0 {
    83			pc := crawler.NewPriority(cfg.Crawler.PriorityPubkeys, cfg.Crawler.Relays,
    84				s, dedup, cdb, cfg.Crawler.Interval, log.With("pkg", "priority"))
    85			go pc.Run(ctx)
    86		}
    87	
    88		// Stats: periodic refresh of snapshot tables.
    89		svc := stats.New(s.CH(), log.With("pkg", "stats"))
    90		go svc.Run(ctx)
    91	
    92		// Forward-declare the relay so the scheduler's publish closure can capture it.
    93		// The closure is only invoked from sched.Run (goroutine), by which point rl is set.
    94		var rl *khatru.Relay
    95		limiter := policy.NewLimiter(600) // per-IP events/reads/REST per minute; tune for your threat model
    96		breadth := policy.RejectFilterBreadth{
    97			MaxIDs: cfg.Policy.MaxIDs, MaxAuthors: cfg.Policy.MaxAuthors,
    98			MaxKinds: cfg.Policy.MaxKinds, MaxTags: cfg.Policy.MaxTags,
    99		}
   100	
   101		// Access control: NIP-42 AUTH + pubkey allow-list (static config ∪ SQLite
   102		// allowed_pubkeys). When enabled, relay.serviceURL MUST be set — it's part
   103		// of the signed AUTH event khatru validates against.
   104		var access *policy.Access
   105		if cfg.Auth.Enabled {
   106			if cfg.Relay.ServiceURL == "" {
   107				log.Error("auth.enabled requires relay.serviceURL (set the canonical relay URL)")
   108				os.Exit(1)
   109			}
   110			access, err = policy.NewAccess(true, cfg.Auth.AllowPubkeys, cfg.Auth.AdminPubkeys,
   111				cfg.Relay.ServiceURL, cdb, log.With("pkg", "access"))
   112			if err != nil {
   113				log.Error("access init failed", "err", err)
   114				os.Exit(1)
   115			}
   116			go refreshLoop(ctx, access, 30*time.Second)
   117		}
   118	
   119		sched := scheduler.New(cdb,
   120			func(ctx context.Context, evt *nostr.Event) error {
   121				_, err := rl.AddEvent(ctx, evt)
   122				return err
   123			},
   124			60*time.Second, log.With("pkg", "scheduler"))
   125		rl = relay.New(relay.Deps{
   126			Store: s, Sched: sched, Limiter: limiter, Breadth: breadth,
   127			Access: access, ServiceURL: cfg.Relay.ServiceURL,
   128		})
   129		go sched.Run(ctx)
   130	
   131		api.NewHandler(svc, s, limiter, access, log.With("pkg", "api")).Register(rl.Router())
   132	
   133		// Ops profiling (stdlib pprof) on loopback only — never on the public port.
   134		// net/http/pprof registers its handlers on http.DefaultServeMux at import.
   135		pprofSrv := &http.Server{Addr: "127.0.0.1:6060", Handler: http.DefaultServeMux}
   136		go func() {
   137			<-ctx.Done()
   138			_ = pprofSrv.Shutdown(context.Background())
   139		}()
   140		go func() {
   141			log.Info("pprof listening", "addr", pprofSrv.Addr)
   142			if err := pprofSrv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
   143				log.Warn("pprof server stopped", "err", err)
   144			}
   145		}()
   146	
   147		// Rate-limit the NIP-86 management RPC: khatru dispatches it by
   148		// Content-Type on any path (outside the /v1/* route wrapping), and each
   149		// unauthenticated attempt costs a ReadAll + base64 + schnorr verify.
   150		handler := limiter.HTTPWhen(
   151			func(r *http.Request) bool {
   152				return r.Header.Get("Content-Type") == "application/nostr+json+rpc"
   153			}, rl)
   154		srv := &http.Server{Addr: cfg.Relay.Addr, Handler: handler}
   155		go func() {
   156			<-ctx.Done()
   157			log.Info("shutting down")
   158			_ = srv.Shutdown(context.Background())
   159		}()
   160	
   161		log.Info("archive relay listening",
   162			"addr", cfg.Relay.Addr, "ch", cfg.ClickHouse.Addr, "sources", *sources,
   163			"priority", len(cfg.Crawler.PriorityPubkeys) > 0, "auth", cfg.Auth.Enabled)
   164		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
   165			log.Error("server error", "err", err)
   166			os.Exit(1)
   167		}
   168	}
   169	
   170	// refreshLoop periodically reloads the dynamic allow-list from SQLite so external
   171	// writes (a billing script, the freedompay webhook) take effect without a restart.
   172	func refreshLoop(ctx context.Context, a *policy.Access, every time.Duration) {
   173		t := time.NewTicker(every)
   174		defer t.Stop()
   175		for {
   176			select {
   177			case <-ctx.Done():
   178				return
   179			case <-t.C:
   180				a.Refresh(ctx)
   181			}
   182		}
   183	}
   184	
   185	func splitSources(s string) []string {
   186		var out []string
   187		for _, v := range strings.Split(s, ",") {
   188			if v = strings.TrimSpace(v); v != "" {
   189				out = append(out, v)
   190			}
   191		}
   192		return out
   193	}
