    12	func (rl *Relay) handleRequest(ctx context.Context, id string, eose *sync.WaitGroup, ws *WebSocket, filter nostr.Filter) error {
    13		defer eose.Done()
    14	
    15		// overwrite the filter (for example, to eliminate some kinds or
    16		// that we know we don't support)
    17		for _, ovw := range rl.OverwriteFilter {
    18			ovw(ctx, &filter)
    19		}
    20	
    21		if filter.LimitZero {
    22			// don't do any queries, just subscribe to future events
    23			return nil
    24		}
    25	
    26		// then check if we'll reject this filter (we apply this after overwriting
    27		// because we may, for example, remove some things from the incoming filters
    28		// that we know we don't support, and then if the end result is an empty
    29		// filter we can just reject it)
    30		for _, reject := range rl.RejectFilter {
    31			if reject, msg := reject(ctx, filter); reject {
    32				return errors.New(nostr.NormalizeOKMessage(msg, "blocked"))
    33			}
    34		}
    35	
    36		// run the functions to query events (generally just one,
    37		// but we might be fetching stuff from multiple places)
    38		eose.Add(len(rl.QueryEvents))
    39		for _, query := range rl.QueryEvents {
    40			ch, err := query(ctx, filter)
    41			if err != nil {
    42				ws.WriteJSON(nostr.NoticeEnvelope(err.Error()))
    43				eose.Done()
    44				continue
    45			} else if ch == nil {
    46				eose.Done()
    47				continue
    48			}
    49	
    50			go func(ch chan *nostr.Event) {
    51				for event := range ch {
    52					for _, ovw := range rl.OverwriteResponseEvent {
    53						ovw(ctx, event)
    54					}
    55					ws.WriteJSON(nostr.EventEnvelope{SubscriptionID: &id, Event: *event})
    56				}
    57				eose.Done()
    58			}(ch)
    59		}
    60	
    61		return nil
    62	}
    63	
    64	func (rl *Relay) handleCountRequest(ctx context.Context, ws *WebSocket, filter nostr.Filter) int64 {
    65		// check if we'll reject this filter
    66		for _, reject := range rl.RejectCountFilter {
    67			if rejecting, msg := reject(ctx, filter); rejecting {
    68				ws.WriteJSON(nostr.NoticeEnvelope(msg))
    69				return 0
    70			}
    71		}
    72	
    73		// run the functions to count (generally it will be just one)
    74		var subtotal int64 = 0
    75		for _, count := range rl.CountEvents {
    76			res, err := count(ctx, filter)
    77			if err != nil {
    78				ws.WriteJSON(nostr.NoticeEnvelope(err.Error()))
    79			}
    80			subtotal += res
    81		}
    82	
    83		return subtotal
    84	}
    85	
    86	func (rl *Relay) handleCountRequestWithHLL(
    87		ctx context.Context,
    88		ws *WebSocket,
    89		filter nostr.Filter,
    90		offset int,
    91	) (int64, *hyperloglog.HyperLogLog) {
    92		// check if we'll reject this filter
