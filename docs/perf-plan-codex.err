# Dev dependencies for archive-relay. Brings up a single-node ClickHouse.
# Usage: docker compose -f deploy/docker-compose.yml up -d
# Then run: ./archive-relay
services:
  clickhouse:
    image: clickhouse/clickhouse-server:26.3
    container_name: archive-relay-ch
    # 26.x requires a password for the default user unless SKIP_USER_SETUP is
    # set. Dev/CI convenience only — for production set a real password
    # (CLICKHOUSE_PASSWORD) and use it in config.yaml.
    environment:
      - CLICKHOUSE_SKIP_USER_SETUP=1
    ports:
      - "9000:9000"   # native protocol (what the relay uses)
      - "8123:8123"   # HTTP (useful for ad-hoc queries / clickhouse-client)
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
    volumes:
      - ch-data:/var/lib/clickhouse
    # To enable the NVMe→S3 cold tier later, mount a custom config:
    # - ./clickhouse-config.xml:/etc/clickhouse-server/config.d/storage.xml
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8123/ping"]
      interval: 5s
      timeout: 3s
      retries: 12

volumes:
  ch-data:
BINARY ?= archive-relay

.PHONY: build run test test-unit test-integration vet fmt clean docker

build:
	go build -o $(BINARY) ./cmd/archive-relay

run: build
	./$(BINARY)

fmt:
	gofmt -s -w .

vet:
	go vet ./...

test: test-unit

test-unit:
	go test ./...

# Integration tests need ClickHouse on $$CH_ADDR (default localhost:9000).
# Excludes internal/crawler (its one test hits a live relay, env-overridable
# via CRAWLER_SOURCE — run it by hand).
test-integration:
	go test -tags=integration -count=1 -timeout 120s ./internal/store/ ./internal/stats/ ./internal/e2e/

clean:
	rm -f $(BINARY)
