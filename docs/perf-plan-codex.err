     1	package crawler
     2	
     3	import (
     4		"context"
     5		"errors"
     6		"log/slog"
     7	
     8		"github.com/nbd-wtf/go-nostr"
     9	
    10		"github.com/nostr-net/archive-relay/internal/store"
    11	)
    12	
    13	// ingest is the shared per-event ingestion step used by the firehose Crawler and
    14	// the PriorityCrawler: in-memory dedup hot path, scope check, signature check,
    15	// then SaveEvent into the tier batchers. Durable dedup (seen_events) is recorded
    16	// post-flush by Dedup.OnFlushed. Returns true if the event was newly enqueued.
    17	func ingest(ctx context.Context, s *store.Store, d *Dedup, log *slog.Logger, ev *nostr.Event) bool {
    18		if d.Seen(ev.ID) {
    19			return false
    20		}
    21		if store.TierForKind(ev.Kind) == store.TierDrop {
    22			return false
    23		}
    24		if ok, _ := ev.CheckSignature(); !ok {
    25			return false
    26		}
    27		// Optimistic: mark in-memory seen now to dedupe within the current buffer
    28		// window; the durable record happens post-flush. If SaveEvent fails below we
    29		// back the mark out on batch-full so a later re-pull retries.
    30		d.Mark(ev.ID)
    31		if err := s.SaveEvent(ctx, ev); err != nil {
    32			if errors.Is(err, store.ErrBatchFull) {
    33				d.Unmark(ev.ID)
    34				log.Warn("batch full; event dropped (will re-ingest next sync)", "id", ev.ID)
    35			} else {
    36				log.Warn("save failed", "id", ev.ID, "err", err)
    37			}
    38			return false
    39		}
    40		return true
    41	}
     1	package crawler
     2	
     3	import (
     4		"context"
     5		"log/slog"
     6		"sync"
     7	
     8		"github.com/nbd-wtf/go-nostr"
     9	
    10		"github.com/nostr-net/archive-relay/internal/control"
    11	)
    12	
    13	// memCap is the per-generation size of the in-memory seen-id cache. An
    14	// unbounded map is a memory leak at firehose rates (GBs/day), so the cache
    15	// rotates: at cap, the current generation becomes the previous one and a fresh
    16	// current starts — at most ~2×memCap ids held, O(1) ops, no LRU bookkeeping.
    17	// Longer lookback comes from the durable seen_events table, which Warm loads
    18	// at startup (bounded by memCap) and OnFlushed appends to per flush.
    19	var memCap = 2_000_000
    20	
    21	// Dedup is the shared in-memory + durable (SQLite seen_events) dedup layer used
    22	// by every ingestion path. The in-memory cache is bounded (two generations);
    23	// ids that age out are simply re-ingested later and collapsed by
    24	// ReplacingMergeTree on read. The durable record is written ONLY after a batch
    25	// is flushed to ClickHouse (via store.OnFlushed, batched in one transaction),
    26	// so a crash never marks an event "seen" before it is durably stored — and on
    27	// restart Warm reloads the most recent ids so the firehose isn't re-ingested.
    28	type Dedup struct {
    29		ctrl *control.DB
    30		log  *slog.Logger
    31	
    32		mu   sync.RWMutex
    33		cur  map[string]struct{}
    34		prev map[string]struct{}
    35	}
    36	
    37	// NewDedup wraps the control plane's durable dedup table with a bounded cache.
    38	// The cache is allocated lazily (no up-front capacity hint) so quiet relays
    39	// don't pay ~100MB for a table they may never fill. Call Warm at startup to
    40	// preload recent ids from seen_events.
    41	func NewDedup(ctrl *control.DB, log *slog.Logger) *Dedup {
    42		return &Dedup{ctrl: ctrl, log: log, cur: make(map[string]struct{})}
    43	}
    44	
    45	// Warm preloads the most recent seen_events ids into the in-memory cache so a
    46	// restart doesn't trigger a mass re-ingest of already-stored events. Bounded
    47	// by memCap. Non-fatal: on error the cache just starts cold.
    48	func (d *Dedup) Warm(ctx context.Context) error {
    49		ids, err := d.ctrl.LoadRecentSeen(ctx, memCap)
    50		if err != nil {
    51			return err
    52		}
    53		d.mu.Lock()
    54		for _, id := range ids {
    55			d.cur[id] = struct{}{}
    56		}
    57		d.mu.Unlock()
    58		if d.log != nil {
    59			d.log.Info("dedup cache warmed", "ids", len(ids))
    60		}
    61		return nil
    62	}
    63	
    64	// Seen reports whether id was ingested recently (in-memory hot path).
    65	func (d *Dedup) Seen(id string) bool {
    66		d.mu.RLock()
    67		defer d.mu.RUnlock()
    68		if _, ok := d.cur[id]; ok {
    69			return true
    70		}
    71		_, ok := d.prev[id]
    72		return ok
    73	}
    74	
    75	// Mark records id as in-flight (optimistic; the durable record happens OnFlushed).
    76	func (d *Dedup) Mark(id string) {
    77		d.mu.Lock()
    78		d.cur[id] = struct{}{}
    79		if len(d.cur) >= memCap {
    80			d.prev = d.cur
    81			d.cur = make(map[string]struct{})
    82		}
    83		d.mu.Unlock()
    84	}
    85	
    86	// Unmark removes the optimistic mark (e.g. on batch-full backpressure).
    87	func (d *Dedup) Unmark(id string) {
    88		d.mu.Lock()
    89		delete(d.cur, id)
    90		delete(d.prev, id)
    91		d.mu.Unlock()
    92	}
    93	
    94	// OnFlushed records durable dedup state for a batch after it is safely in
    95	// ClickHouse: one SQLite transaction for the whole batch (not one autocommit
    96	// per event, which would stall the flush loop at firehose rates). Wire this
    97	// to store.SetOnFlushed.
    98	func (d *Dedup) OnFlushed(events []*nostr.Event) {
    99		refs := make([]control.SeenRef, 0, len(events))
   100		for _, ev := range events {
   101			d.Mark(ev.ID)
   102			refs = append(refs, control.SeenRef{ID: ev.ID, CreatedAt: int64(ev.CreatedAt)})
   103		}
   104		if err := d.ctrl.MarkSeenBatch(context.Background(), refs); err != nil && d.log != nil {
   105			d.log.Warn("seen_events batch write failed", "n", len(refs), "err", err)
   106		}
   107	}
     1	// Package crawler ingests events from upstream nostr relays into the store.
     2	// Each source relay gets a goroutine that subscribes to the in-scope kinds and
     3	// feeds received events through the store's batched SaveEvent path, with
     4	// SQLite-backed dedup so re-ingest is idempotent.
     5	package crawler
     6	
     7	import (
     8		"context"
     9		"log/slog"
    10		"sync"
    11		"time"
    12	
    13		"github.com/nbd-wtf/go-nostr"
    14	
    15		"github.com/nostr-net/archive-relay/internal/store"
    16	)
    17	
    18	// Crawler fans out one ingestion goroutine per source relay URL.
    19	type Crawler struct {
    20		sources []string
    21		store   *store.Store
    22		dedup   *Dedup
    23		log     *slog.Logger
    24	}
    25	
    26	// New constructs a firehose Crawler for the given source relay URLs. dedup is
    27	// shared with any per-pubkey PriorityCrawler; wire dedup.OnFlushed to
    28	// store.SetOnFlushed once at startup.
    29	func New(sources []string, s *store.Store, dedup *Dedup, log *slog.Logger) *Crawler {
    30		return &Crawler{sources: sources, store: s, dedup: dedup, log: log}
    31	}
    32	
    33	// Run starts ingestion from all sources and blocks until ctx is canceled.
    34	func (c *Crawler) Run(ctx context.Context) {
    35		if len(c.sources) == 0 {
    36			c.log.Warn("crawler has no source relays configured")
    37			return
    38		}
    39		// Prune the dedup table hourly so it doesn't grow unbounded. seen_events is
    40		// only useful for restart-warm and the backfill window; older rows are dead
    41		// weight.
    42		go c.pruneLoop(ctx, time.Hour, 7*24*time.Hour)
    43	
    44		kinds := store.InScopeKinds()
    45		var wg sync.WaitGroup
    46		for _, url := range c.sources {
    47			wg.Add(1)
    48			go func(url string) {
    49				defer wg.Done()
    50				c.runSource(ctx, url, kinds)
    51			}(url)
    52		}
    53		wg.Wait()
    54	}
    55	
    56	func (c *Crawler) pruneLoop(ctx context.Context, every, maxAge time.Duration) {
    57		t := time.NewTicker(every)
    58		defer t.Stop()
    59		for {
    60			select {
    61			case <-ctx.Done():
    62				return
    63			case <-t.C:
    64				if n, err := c.dedup.ctrl.PruneSeen(ctx, maxAge); err != nil {
    65					c.log.Warn("prune seen_events failed", "err", err)
    66				} else if n > 0 {
    67					c.log.Info("pruned seen_events", "rows", n)
    68				}
    69			}
    70		}
    71	}
    72	
    73	// runSource connects (with reconnect+backoff) and subscribes to the in-scope
    74	// kinds, persisting every received event.
    75	func (c *Crawler) runSource(ctx context.Context, url string, kinds []int) {
    76		log := c.log.With("source", url)
    77		filter := nostr.Filter{Kinds: kinds}
    78		// no Limit: take the relay's historical backlog, then stay open for live.
    79		backoff := time.Second
    80	
    81		for ctx.Err() == nil {
    82			relay := nostr.NewRelay(ctx, url)
    83			if err := relay.Connect(ctx); err != nil {
    84				log.Warn("connect failed; retrying", "err", err, "backoff", backoff)
    85				sleepCtx(ctx, backoff)
    86				backoff = nextBackoff(backoff)
    87				continue
    88			}
    89			backoff = time.Second
    90			log.Info("connected; subscribing", "kinds", kinds)
    91	
    92			sub, err := relay.Subscribe(ctx, nostr.Filters{filter})
    93			if err != nil {
    94				log.Warn("subscribe failed; reconnecting", "err", err)
    95				sleepCtx(ctx, 2*time.Second)
    96				continue
    97			}
    98	
    99			ingested, skipped := 0, 0
   100			for {
   101				select {
   102				case <-ctx.Done():
   103					return
   104				case <-sub.EndOfStoredEvents:
   105					log.Info("EOSE; continuing for live events", "ingested", ingested, "skipped", skipped)
   106				case reason := <-sub.ClosedReason:
   107					log.Warn("subscription closed; reconnecting", "reason", reason)
   108					sleepCtx(ctx, 2*time.Second)
   109					goto reconnect
   110				case ev, ok := <-sub.Events:
   111					if !ok {
   112						log.Info("events channel closed; reconnecting", "ingested", ingested)
   113						goto reconnect
   114					}
   115					if c.handle(ctx, ev) {
   116						ingested++
   117					} else {
   118						skipped++
   119					}
   120				}
   121			}
   122		reconnect:
   123			_ = relay.Close()
   124		}
   125	}
   126	
   127	// handle applies in-memory dedup (fast hot path) and saves new events to
   128	// ClickHouse through the shared ingest path.
   129	func (c *Crawler) handle(ctx context.Context, ev *nostr.Event) bool {
   130		return ingest(ctx, c.store, c.dedup, c.log, ev)
   131	}
   132	
   133	func sleepCtx(ctx context.Context, d time.Duration) {
   134		t := time.NewTimer(d)
   135		defer t.Stop()
   136		select {
   137		case <-ctx.Done():
   138		case <-t.C:
   139		}
   140	}
   141	
   142	func nextBackoff(d time.Duration) time.Duration {
   143		d *= 2
   144		if d > 60*time.Second {
   145			return 60 * time.Second
   146		}
   147		return d
   148	}
     1	package crawler
     2	
     3	import (
     4		"context"
     5		"log/slog"
     6		"time"
     7	
     8		"github.com/nbd-wtf/go-nostr"
     9	
    10		"github.com/nostr-net/archive-relay/internal/control"
    11		"github.com/nostr-net/archive-relay/internal/store"
    12	)
    13	
    14	const (
    15		// fetchOverlap is the re-pull window on incremental ticks: since =
    16		// last_fetched - fetchOverlap. Generous overlap covers relay propagation
    17		// delay and backdated events that arrive late.
    18		fetchOverlap = 24 * time.Hour
    19		// fetchTimeout bounds one relay fetch; a relay that connects but never
    20		// sends EOSE stalls the tick without it.
    21		fetchTimeout = 5 * time.Minute
    22		// fullSweepAge is how stale last_fetched must get before a pubkey gets a
    23		// full-history re-pull instead of an incremental one — a completeness
    24		// safety net for late-arriving old events. Based on persisted state, not a
    25		// tick counter, so restarts don't trigger a spurious sweep. 24h.
    26		fullSweepAge = 24 * time.Hour
    27	)
    28	
    29	// PriorityCrawler fetches the history of a configured set of pubkeys from a
    30	// dedicated relay list (separate from the firehose -sources), ensuring their
    31	// in-scope events are captured even when the firehose misses them. It shares
    32	// the store + Dedup layer with the firehose Crawler, and records last_fetched
    33	// in crawl_state — which bounds the next tick's `since` filter so each crawl
    34	// is incremental (with a periodic full-history sweep for completeness).
    35	// It does NOT change the stored kind scope — "preserve everything" here means
    36	// all in-scope kinds, completeness-assured.
    37	type PriorityCrawler struct {
    38		pubkeys  []string
    39		relays   []string
    40		store    *store.Store
    41		dedup    *Dedup
    42		ctrl     *control.DB
    43		interval time.Duration
    44		log      *slog.Logger
    45	}
    46	
    47	// NewPriority constructs a PriorityCrawler. pubkeys/relays must be non-empty for
    48	// Run to do anything.
    49	func NewPriority(pubkeys, relays []string, s *store.Store, d *Dedup, ctrl *control.DB,
    50		interval time.Duration, log *slog.Logger) *PriorityCrawler {
    51		if interval <= 0 {
    52			interval = 10 * time.Minute
    53		}
    54		return &PriorityCrawler{pubkeys: pubkeys, relays: relays, store: s, dedup: d,
    55			ctrl: ctrl, interval: interval, log: log}
    56	}
    57	
    58	// Run crawls each pubkey immediately, then on every interval, until ctx is done.
    59	func (p *PriorityCrawler) Run(ctx context.Context) {
    60		if len(p.pubkeys) == 0 || len(p.relays) == 0 {
    61			p.log.Warn("priority crawler disabled: need both pubkeys and relays",
    62				"pubkeys", len(p.pubkeys), "relays", len(p.relays))
    63			return
    64		}
    65		p.tick(ctx)
    66		t := time.NewTicker(p.interval)
    67		defer t.Stop()
    68		for {
    69			select {
    70			case <-ctx.Done():
    71				return
    72			case <-t.C:
    73				p.tick(ctx)
    74			}
    75		}
    76	}
    77	
    78	func (p *PriorityCrawler) tick(ctx context.Context) {
    79		kinds := store.InScopeKinds()
    80		for _, pk := range p.pubkeys {
    81			if ctx.Err() != nil {
    82				return
    83			}
    84			p.fetchPubkey(ctx, pk, kinds)
    85		}
    86	}
    87	
    88	// fetchPubkey pulls one pubkey's events from the first relay that serves it,
    89	// then records last_fetched. Trying relays in order lets a pubkey be completed
    90	// from one relay even if another is down.
    91	func (p *PriorityCrawler) fetchPubkey(ctx context.Context, pubkey string, kinds []int) {
    92		log := p.log.With("pubkey", pubkey)
    93	
    94		// Incremental bound: since = last_fetched - fetchOverlap (so relay delay
    95		// and clock skew don't drop events). A pubkey is fetched in full when it
    96		// has never been crawled or last_fetched is older than fullSweepAge — the
    97		// persisted completeness sweep for late-arriving old events.
    98		var since *nostr.Timestamp
    99		last, err := p.ctrl.LastFetched(ctx, pubkey)
   100		switch {
   101		case err != nil:
   102			log.Warn("last_fetched lookup failed; doing full fetch", "err", err)
   103		case last == 0 || time.Since(time.Unix(last, 0)) >= fullSweepAge:
   104			// full fetch: no bound
   105		default:
   106			if ts := last - int64(fetchOverlap/time.Second); ts > 0 {
   107				t := nostr.Timestamp(ts)
   108				since = &t
   109			}
   110		}
   111	
   112		for _, url := range p.relays {
   113			if ctx.Err() != nil {
   114				return
   115			}
   116			if p.fetchFrom(ctx, url, pubkey, kinds, since, log) {
   117				_ = p.ctrl.MarkFetched(ctx, pubkey)
   118				return
   119			}
   120		}
   121		log.Warn("no relay served this pubkey", "relays", p.relays)
   122	}
   123	
   124	// fetchFrom connects to one relay, subscribes to the pubkey's in-scope events
   125	// (bounded by `since` on incremental ticks), and ingests everything until EOSE.
   126	// The fetch is bounded by fetchTimeout; a stalled relay reports false so the
   127	// next relay is tried, as does a subscription closed before EOSE or a dropped
   128	// events channel — anything short of a clean EOSE must not advance
   129	// last_fetched past events that were never fetched.
   130	func (p *PriorityCrawler) fetchFrom(parent context.Context, url, pubkey string,
   131		kinds []int, since *nostr.Timestamp, log *slog.Logger) bool {
   132		ctx, cancel := context.WithTimeout(parent, fetchTimeout)
   133		defer cancel()
   134	
   135		relay := nostr.NewRelay(ctx, url)
   136		if err := relay.Connect(ctx); err != nil {
   137			log.Warn("connect failed", "relay", url, "err", err)
   138			return false // try the next relay
   139		}
   140		defer relay.Close()
   141	
   142		sub, err := relay.Subscribe(ctx, nostr.Filters{{
   143			Authors: []string{pubkey}, Kinds: kinds, Since: since,
   144		}})
   145		if err != nil {
   146			log.Warn("subscribe failed", "relay", url, "err", err)
   147			return false // try the next relay
   148		}
   149	
   150		ingested, skipped := 0, 0
   151		for {
   152			select {
   153			case <-ctx.Done():
   154				if parent.Err() == nil {
   155					// fetchTimeout hit, not shutdown — try the next relay
   156					log.Warn("fetch timed out", "relay", url, "ingested", ingested)
   157				}
   158				// shutdown or timeout: incomplete either way — only a clean EOSE
   159				// is "done" (the fetchPubkey loop's ctx.Err() guard aborts on shutdown).
   160				return false
   161			case <-sub.EndOfStoredEvents:
   162				log.Info("priority crawl done", "relay", url, "ingested", ingested, "skipped", skipped)
   163				return true
   164			case reason := <-sub.ClosedReason:
   165				log.Warn("subscription closed before EOSE", "relay", url, "reason", reason)
   166				return false // incomplete — try the next relay
   167			case ev, ok := <-sub.Events:
   168				if !ok {
   169					log.Warn("events channel closed before EOSE", "relay", url, "ingested", ingested)
   170					return false // incomplete — try the next relay
   171				}
   172				if ingest(ctx, p.store, p.dedup, p.log, ev) {
   173					ingested++
   174				} else {
   175					skipped++
   176				}
   177			}
   178		}
   179	}
     1	// Package control is the embedded SQLite control plane for the relay: the
     2	// small mutable, high-frequency-update state that ClickHouse is bad at
     3	// (crawler progress, scheduled events, dedup, allow-list). It is a
     4	// library-backed .db file, NOT a separate server — part of the one binary.
     5	package control
     6	
     7	import (
     8		"context"
     9		"database/sql"
    10		"errors"
    11		"fmt"
    12		"log/slog"
    13		"time"
    14	
    15		_ "modernc.org/sqlite" // pure-Go SQLite driver (no CGo)
    16	)
    17	
    18	const schema = `
    19	CREATE TABLE IF NOT EXISTS crawl_state (
    20	  pubkey        TEXT PRIMARY KEY,
    21	  last_fetched  INTEGER NOT NULL DEFAULT 0,
    22	  updated_at    INTEGER NOT NULL DEFAULT 0
    23	);
    24	
    25	CREATE TABLE IF NOT EXISTS scheduled_events (
    26	  id         TEXT PRIMARY KEY,          -- the future-dated event id
    27	  event_json TEXT NOT NULL,             -- full serialized event
    28	  publish_at INTEGER NOT NULL           -- created_at, when to publish
    29	);
    30	CREATE INDEX IF NOT EXISTS idx_scheduled_due ON scheduled_events(publish_at);
    31	
    32	CREATE TABLE IF NOT EXISTS seen_events (
    33	  id TEXT PRIMARY KEY,
    34	  created_at INTEGER NOT NULL DEFAULT 0
    35	);
    36	
    37	-- Customers granted relay access. Mutated via NIP-86 management RPC (and later
    38	-- the freedompay webhook). Static always-allowed keys live in config instead.
    39	CREATE TABLE IF NOT EXISTS allowed_pubkeys (
    40	  pubkey     TEXT PRIMARY KEY,
    41	  note       TEXT,
    42	  created_at INTEGER NOT NULL DEFAULT 0
    43	);
    44	`
    45	
    46	// DB wraps the SQLite connection used by crawler, scheduler, and auth.
    47	type DB struct {
    48		conn *sql.DB
    49		log  *slog.Logger
    50	}
    51	
    52	// Open opens (creating if absent) the control DB and ensures the schema.
    53	func Open(path string, log *slog.Logger) (*DB, error) {
    54		conn, err := sql.Open("sqlite", path+"?_pragma=journal_mode(WAL)&_pragma=busy_timeout(5000)")
    55		if err != nil {
    56			return nil, err
    57		}
    58		// SQLite is single-writer; a small pool is plenty and lets query vs write overlap.
    59		conn.SetMaxOpenConns(4)
    60		if _, err := conn.Exec(schema); err != nil {
    61			return nil, fmt.Errorf("control schema init: %w", err)
    62		}
    63		log.Info("control db ready", "path", path)
    64		return &DB{conn: conn, log: log}, nil
    65	}
    66	
    67	func (d *DB) Close() error { return d.conn.Close() }
    68	
    69	// MarkSeen records an event id as ingested, for idempotent batcher dedup.
    70	// Returns true if it was newly inserted (i.e. not seen before).
    71	func (d *DB) MarkSeen(ctx context.Context, id string, createdAt int64) (bool, error) {
    72		res, err := d.conn.ExecContext(ctx,
    73			"INSERT OR IGNORE INTO seen_events(id, created_at) VALUES(?, ?)", id, createdAt)
    74		if err != nil {
    75			return false, err
    76		}
    77		n, _ := res.RowsAffected()
    78		return n > 0, nil
    79	}
    80	
    81	// SeenRef is one (id, created_at) pair for a batched MarkSeen.
    82	type SeenRef struct {
    83		ID        string
    84		CreatedAt int64
    85	}
    86	
    87	// MarkSeenBatch records many seen ids in a single transaction. Used by the
    88	// post-flush hook so a whole ClickHouse batch costs one commit, not one
    89	// autocommit per event.
    90	func (d *DB) MarkSeenBatch(ctx context.Context, items []SeenRef) error {
    91		if len(items) == 0 {
    92			return nil
    93		}
    94		tx, err := d.conn.BeginTx(ctx, nil)
    95		if err != nil {
    96			return err
    97		}
    98		defer tx.Rollback()
    99		stmt, err := tx.PrepareContext(ctx,
   100			"INSERT OR IGNORE INTO seen_events(id, created_at) VALUES(?, ?)")
   101		if err != nil {
   102			return err
   103		}
   104		defer stmt.Close()
   105		for _, it := range items {
   106			if _, err := stmt.ExecContext(ctx, it.ID, it.CreatedAt); err != nil {
   107				return err
   108			}
   109		}
   110		return tx.Commit()
   111	}
   112	
   113	// LoadRecentSeen returns up to limit most-recently-recorded seen ids (insert
   114	// order via rowid), used to warm the in-memory dedup cache after a restart so
   115	// recent events aren't re-ingested.
   116	func (d *DB) LoadRecentSeen(ctx context.Context, limit int) ([]string, error) {
   117		rows, err := d.conn.QueryContext(ctx,
   118			"SELECT id FROM seen_events ORDER BY rowid DESC LIMIT ?", limit)
   119		if err != nil {
   120			return nil, err
   121		}
   122		defer rows.Close()
   123		var out []string
   124		for rows.Next() {
   125			var id string
   126			if err := rows.Scan(&id); err != nil {
   127				return nil, err
   128			}
   129			out = append(out, id)
   130		}
   131		return out, rows.Err()
   132	}
   133	
   134	// PruneSeen deletes seen_events rows older than maxAge. seen_events is only
   135	// useful for backfill dedup (days/weeks), not archival — without pruning it
   136	// grows ~one row per ingested event forever, which at firehose scale is a real
   137	// disk problem. Call periodically (e.g. hourly, maxAge ~7 days).
   138	func (d *DB) PruneSeen(ctx context.Context, maxAge time.Duration) (int64, error) {
   139		cutoff := time.Now().Add(-maxAge).Unix()
   140		res, err := d.conn.ExecContext(ctx, "DELETE FROM seen_events WHERE created_at < ?", cutoff)
   141		if err != nil {
   142			return 0, err
   143		}
   144		n, _ := res.RowsAffected()
   145		return n, nil
   146	}
   147	
   148	// AllowedPubkey is one row of the dynamic allow-list.
   149	type AllowedPubkey struct {
   150		Pubkey    string
   151		Note      string
   152		CreatedAt int64
   153	}
   154	
   155	// AllowPubkey grants access to a pubkey (INSERT OR REPLACE so it's idempotent).
   156	func (d *DB) AllowPubkey(ctx context.Context, pubkey, note string) error {
   157		_, err := d.conn.ExecContext(ctx,
   158			"INSERT OR REPLACE INTO allowed_pubkeys(pubkey, note, created_at) VALUES(?, ?, ?)",
   159			pubkey, note, time.Now().Unix())
   160		return err
   161	}
   162	
   163	// RevokePubkey removes a pubkey's access. No-op (no error) if not present.
   164	func (d *DB) RevokePubkey(ctx context.Context, pubkey string) error {
   165		_, err := d.conn.ExecContext(ctx, "DELETE FROM allowed_pubkeys WHERE pubkey = ?", pubkey)
   166		return err
   167	}
   168	
   169	// ListAllowed returns every dynamic allow-list row, oldest first.
   170	func (d *DB) ListAllowed(ctx context.Context) ([]AllowedPubkey, error) {
   171		rows, err := d.conn.QueryContext(ctx,
   172			"SELECT pubkey, note, created_at FROM allowed_pubkeys ORDER BY created_at")
   173		if err != nil {
   174			return nil, err
   175		}
   176		defer rows.Close()
   177		var out []AllowedPubkey
   178		for rows.Next() {
   179			var a AllowedPubkey
   180			if err := rows.Scan(&a.Pubkey, &a.Note, &a.CreatedAt); err != nil {
   181				return nil, err
   182			}
   183			out = append(out, a)
   184		}
   185		return out, rows.Err()
   186	}
   187	
   188	// LoadAllowedSet returns the set of allowed pubkeys for an in-memory cache.
   189	func (d *DB) LoadAllowedSet(ctx context.Context) (map[string]struct{}, error) {
   190		rows, err := d.conn.QueryContext(ctx, "SELECT pubkey FROM allowed_pubkeys")
   191		if err != nil {
   192			return nil, err
   193		}
   194		defer rows.Close()
   195		out := make(map[string]struct{})
   196		for rows.Next() {
   197			var pk string
   198			if err := rows.Scan(&pk); err != nil {
   199				return nil, err
   200			}
   201			out[pk] = struct{}{}
   202		}
   203		return out, rows.Err()
   204	}
   205	
   206	// LastFetched returns the last successful priority-crawl time for a pubkey
   207	// (0 if the pubkey was never crawled).
   208	func (d *DB) LastFetched(ctx context.Context, pubkey string) (int64, error) {
   209		var ts int64
   210		err := d.conn.QueryRowContext(ctx,
   211			"SELECT last_fetched FROM crawl_state WHERE pubkey = ?", pubkey).Scan(&ts)
   212		if errors.Is(err, sql.ErrNoRows) {
   213			return 0, nil
   214		}
   215		return ts, err
   216	}
   217	
   218	// MarkFetched records that a priority-crawl pubkey was just fetched (used by
   219	// the per-pubkey crawler for last_fetched visibility and incremental fetches).
   220	func (d *DB) MarkFetched(ctx context.Context, pubkey string) error {
   221		now := time.Now().Unix()
   222		_, err := d.conn.ExecContext(ctx, `
   223	INSERT INTO crawl_state(pubkey, last_fetched, updated_at) VALUES(?, ?, ?)
   224	ON CONFLICT(pubkey) DO UPDATE SET last_fetched = excluded.last_fetched, updated_at = excluded.updated_at`,
   225			pubkey, now, now)
   226		return err
   227	}
   228	
   229	// --- scheduled (future-dated) events ---
   230	
   231	// SaveScheduled parks (or replaces) a future-dated event row.
   232	func (d *DB) SaveScheduled(ctx context.Context, id, eventJSON string, publishAt int64) error {
   233		_, err := d.conn.ExecContext(ctx,
   234			"INSERT OR REPLACE INTO scheduled_events(id, event_json, publish_at) VALUES(?, ?, ?)",
   235			id, eventJSON, publishAt)
   236		return err
   237	}
   238	
   239	// ScheduledEvent is one parked future-dated event.
   240	type ScheduledEvent struct {
   241		ID        string
   242		EventJSON string
   243	}
   244	
   245	// LoadDueScheduled returns up to limit parked events whose publish time has
   246	// passed, oldest first.
   247	func (d *DB) LoadDueScheduled(ctx context.Context, now int64, limit int) ([]ScheduledEvent, error) {
   248		rows, err := d.conn.QueryContext(ctx,
   249			"SELECT id, event_json FROM scheduled_events WHERE publish_at <= ? ORDER BY publish_at LIMIT ?",
   250			now, limit)
   251		if err != nil {
   252			return nil, err
   253		}
   254		defer rows.Close()
   255		var out []ScheduledEvent
   256		for rows.Next() {
   257			var e ScheduledEvent
   258			if err := rows.Scan(&e.ID, &e.EventJSON); err != nil {
   259				return nil, err
   260			}
   261			out = append(out, e)
   262		}
   263		return out, rows.Err()
   264	}
   265	
   266	// DeleteScheduled removes a parked event (after it was published or proven
   267	// unloadable).
   268	func (d *DB) DeleteScheduled(ctx context.Context, id string) error {
   269		_, err := d.conn.ExecContext(ctx, "DELETE FROM scheduled_events WHERE id = ?", id)
   270		return err
   271	}

