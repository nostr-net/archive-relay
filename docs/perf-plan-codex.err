   195	func TestStoreDeleteTombstone(t *testing.T) {
   196		s, _, teardown := setupStore(t)
   197		defer teardown()
   198		ctx := context.Background()
   199	
   200		sk := nostr.GeneratePrivateKey()
   201		evt := signEvent(t, sk, 1, "doomed", nostr.Tags{}, 0)
   202		s.SaveEvent(ctx, evt)
   203		s.FlushAll()
   204	
   205		// visible before deletion
   206		ch, _ := s.QueryEvents(ctx, nostr.Filter{IDs: []string{evt.ID}})
   207		if len(drain(ch)) != 1 {
   208			t.Fatal("expected visible before delete")
   209		}
   210	
   211		// tombstone it
   212		if err := s.DeleteEvent(ctx, evt); err != nil {
   213			t.Fatalf("DeleteEvent: %v", err)
   214		}
   215		// reload dictionary so the tombstone predicate sees it immediately
   216		_ = s.ch.Exec(ctx, "SYSTEM RELOAD DICTIONARY tombstone_dict")
   217	
   218		ch, _ = s.QueryEvents(ctx, nostr.Filter{IDs: []string{evt.ID}})
   219		got := drain(ch)
   220		if len(got) != 0 {
   221			t.Fatalf("expected hidden after tombstone, got %d", len(got))
   222		}
   223		// but still physically present (tombstone only hides)
   224		var n uint64
   225		_ = s.ch.QueryRow(ctx, fmt.Sprintf("SELECT count() FROM events_archive WHERE id = '%s'", evt.ID)).Scan(&n)
   226		if n != 1 {
   227			t.Fatalf("expected raw row to still exist, got count=%d", n)
   228		}
   229	}
